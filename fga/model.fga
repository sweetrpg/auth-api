model
  schema 1.1

# Platform roles, expressed as relations on the platform object. Mirrors models/role.go.
type user

type platform
  relations
    define user: [user]
    define submitter: [user]
    define editor: [user]
    define moderator: [user]
    define approver: [user]
    define admin: [user]
    define openfga-writer: [user]

# Volume edit approval (volume-edit-approval workflow). Scoped per volume-edit object.
type volume-edit
  relations
    define submitter: [user]
    define approver: [user]

# Initiative! sessions (PADR-0035). Membership tuples are written by initiative-api; the gm, co_gm,
# player and observer relations are direct. can_view and the encounter relations derive from them.
type session
  relations
    define gm: [user]
    define co_gm: [user]
    define player: [user]
    define observer: [user]
    define can_view: gm or co_gm or player or observer
    define can_edit: gm or co_gm
    define can_approve: gm or co_gm

# An encounter belongs to one session and inherits access from it.
type encounter
  relations
    define parent: [session]
    define can_view: can_view from parent
    define can_edit: can_edit from parent
    define can_approve: can_approve from parent
